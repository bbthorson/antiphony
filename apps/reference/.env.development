# Antiphony reference app — local dev defaults.
# All values are non-secret local dev config (committed on purpose).

# --- Server-side (read by server/dev-bff.ts, NEVER bundled) -----------------
# No VITE_ prefix, so Vite cannot inline these into the client.

# Where the dev BFF forwards /api/v1/*. core-api runs on the Workers runtime
# now (`npm run dev` -> `wrangler dev`), which serves :8787. It used to be
# :8090, chosen because the firestore emulator owned :8080 — both that emulator
# and the Node host it ran under are gone.
ANTIPHONY_CORE_API_URL=http://localhost:8787

# The app's service credential. Must match an appId:token pair in core-api's
# ANTIPHONY_APP_TOKENS, and the token must be >=32 chars. This local value is
# a throwaway for local dev; a real deployment keeps it in a secret
# store, never in a committed file.
ANTIPHONY_SERVICE_TOKEN=reference-local-dev-token-0123456789abcdef

# Who the BFF asserts is acting. A real BFF derives this from its own session;
# the reference app has no accounts, so every post is authored by this id.
ANTIPHONY_ACTING_ACTOR=reference-user

# --- Client-side (inlined into the bundle) ---------------------------------
# Display only. The browser never addresses core-api directly.
VITE_CORE_API_LABEL=http://localhost:8787
