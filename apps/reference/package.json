{
  "name": "@antiphony/reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neutral reference creation app for the Antiphony contract \u2014 record \u2192 upload \u2192 create audio.post \u2192 hydrate \u2192 render. NO product branding; this is the contract's acceptance harness and the capture-kit seed. Ships a dev BFF that holds the service token server-side.",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode production",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@antiphony/capture-kit": "*",
    "@antiphony/shared": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.16.0",
    "globals": "^17.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
