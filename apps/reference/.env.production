# Antiphony reference app — LIVE config (vite build / vite preview).
#
# Points the dev BFF at the deployed core-api on the `antiphony-core` project.
#
# NOTE: ANTIPHONY_SERVICE_TOKEN is deliberately ABSENT here. A live service
# token is a real secret — it authenticates the application, so anyone holding
# it can act as any user in that tenancy. Put it in `.env.local` (gitignored)
# or the environment:
#
#   ANTIPHONY_SERVICE_TOKEN=… npm run preview -w @antiphony/reference
#
# Without it the BFF returns a 500 explaining what's missing, rather than
# forwarding an unauthenticated request.

# --- Server-side (read by server/dev-bff.ts, NEVER bundled) -----------------
# Live API. api.antiphony.dev is the canonical custom domain.
ANTIPHONY_CORE_API_URL=https://api.antiphony.dev
ANTIPHONY_ACTING_ACTOR=reference-user

# --- Client-side (inlined into the bundle) ---------------------------------
VITE_CORE_API_LABEL=https://api.antiphony.dev
