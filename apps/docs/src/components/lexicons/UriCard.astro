---
/** The shape of a post's at:// URI, authority and rkey called out. */
---

<div class="not-content ap-uri">
	<div class="head">Post URI</div>
	<div class="body">at://<span class="authority">did:web:&lt;tenant&gt;</span>/dev.antiphony.audio.post/<span class="rkey">&lt;rkey&gt;</span></div>
</div>

<style>
	.ap-uri {
		overflow: hidden;
		background: var(--ap-surface-elevated);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		font-family: var(--ap-font-mono);
	}

	.head {
		padding: 10px 14px;
		border-bottom: 1px solid var(--ap-border-subtle);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ap-text-muted);
	}

	.body {
		padding: 14px 16px;
		font-size: 12px;
		line-height: 1.75;
		overflow-wrap: anywhere;
		color: var(--ap-text-secondary);
	}

	.authority {
		color: var(--ap-call-ink);
	}

	.rkey {
		color: var(--ap-response-ink);
	}
</style>
