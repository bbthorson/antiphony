---
import type { MarkdownHeading } from 'astro';

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];

interface Props {
	entries: Entry[];
	questions: MarkdownHeading[];
	nested?: boolean;
}

const { entries, questions, nested = false } = Astro.props;
---

<div class:list={['entries', { nested }]}>
	{entries.map((entry) =>
		entry.type === 'link' ? (
			<div>
				<a
					href={entry.href}
					aria-current={entry.isCurrent ? 'page' : undefined}
					class:list={['item', { current: entry.isCurrent }]}
					{...entry.attrs}
				>
					{entry.label}
				</a>
				{entry.isCurrent && questions.length > 0 && (
					<div class="questions">
						{questions.map((q) => (
							<a href={`#${q.slug}`} class="question">
								<span class="dot" aria-hidden="true" />
								{q.text}
							</a>
						))}
					</div>
				)}
			</div>
		) : (
			<div class="group">
				<div class="group-label">{entry.label}</div>
				<Astro.self entries={entry.entries} questions={questions} nested />
			</div>
		),
	)}
</div>

<style>
	.entries {
		display: flex;
		flex-direction: column;
	}

	.entries:not(.nested) {
		padding-top: 4px;
	}

	.group {
		margin-bottom: 24px;
	}

	.nested .group {
		margin: 8px 0 0 12px;
	}

	.group-label {
		margin-bottom: 8px;
		padding-left: 12px;
		font-size: 12px;
		font-weight: 600;
		color: var(--ap-text-primary);
	}

	.item {
		display: block;
		padding: 5px 12px;
		font-size: 14px;
		line-height: 1.4;
		text-decoration: none;
		color: var(--ap-text-secondary);
		box-shadow: inset 2px 0 0 transparent;
		transition: color var(--ap-transition-fast);
	}

	.item:hover {
		color: var(--ap-text-primary);
	}

	.item.current {
		color: var(--ap-text-primary);
		font-weight: 600;
		box-shadow: inset 2px 0 0 var(--ap-call);
	}

	.questions {
		display: flex;
		flex-direction: column;
		margin: 4px 0 6px 12px;
		border-left: 1px solid var(--ap-border-default);
	}

	.question {
		display: flex;
		gap: 8px;
		padding: 4px 0 4px 12px;
		font-size: 13px;
		line-height: 1.4;
		color: var(--ap-text-secondary);
		text-decoration: none;
	}

	.question:hover {
		color: var(--ap-call-ink);
	}

	.dot {
		width: 6px;
		height: 6px;
		flex: none;
		margin-top: 6px;
		border-radius: var(--ap-radius-full);
		background: var(--ap-call);
	}
</style>
