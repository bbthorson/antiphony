---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const currentPath = Astro.url.pathname;
const { hasSidebar } = Astro.locals.starlightRoute;

const navItems = [
	{ label: 'Lexicons', href: '/lexicons/overview/', badge: 'Protocol' },
	{ label: 'Guides', href: '/self-hosting/quick-start/' },
	{ label: 'Capture Kit', href: '/build-your-own/capture-kit/' },
	{ label: 'Architecture', href: '/introduction/architecture/' },
	{ label: 'API Reference', href: '/api/overview/' },
];

function isActive(href: string): boolean {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href.replace(/\/$/, ''));
}
---

<div class="header">
	<div class="header-left">
		<div class="title-wrapper sl-flex">
			<SiteTitle {...Astro.props} />
		</div>

		<!-- Top-level Primary Navigation Links (Desktop only via media query) -->
		<nav class="top-nav print:hidden" aria-label="Main Navigation">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { active: isActive(item.href) }]}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					<span>{item.label}</span>
					{item.badge && <span class="nav-badge">{item.badge}</span>}
				</a>
			))}
		</nav>
	</div>

	<div class="header-right">
		<div class="search-wrapper sl-flex print:hidden">
			<Search {...Astro.props} />
		</div>

		<div class="right-group print:hidden">
			<div class="sl-flex social-icons">
				<SocialIcons {...Astro.props} />
			</div>
			<ThemeSelect {...Astro.props} />
			<LanguageSelect {...Astro.props} />
		</div>

		<!-- Mobile Menu Button (rendered on splash pages without a sidebar) -->
		{!hasSidebar && (
			<button
				type="button"
				class="mobile-menu-btn print:hidden"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="mobile-nav-drawer"
				id="mobile-menu-trigger"
			>
				<svg class="menu-icon-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		)}
	</div>
</div>

<!-- Mobile Navigation Drawer for Splash Pages -->
{!hasSidebar && (
	<div id="mobile-nav-drawer" class="mobile-nav-drawer print:hidden" hidden aria-hidden="true">
		<nav class="mobile-nav-list" aria-label="Mobile Navigation">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={['mobile-nav-link', { active: isActive(item.href) }]}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					<span>{item.label}</span>
					{item.badge && <span class="nav-badge">{item.badge}</span>}
				</a>
			))}
		</nav>
		<div class="mobile-nav-footer">
			<div class="mobile-social sl-flex">
				<SocialIcons {...Astro.props} />
			</div>
			<div class="mobile-theme">
				<ThemeSelect {...Astro.props} />
			</div>
		</div>
	</div>
)}

<script>
	const trigger = document.getElementById('mobile-menu-trigger');
	const drawer = document.getElementById('mobile-nav-drawer');

	if (trigger && drawer) {
		const iconBars = trigger.querySelector('.menu-icon-bars') as HTMLElement | null;
		const iconClose = trigger.querySelector('.menu-icon-close') as HTMLElement | null;

		function setMenuOpen(open: boolean) {
			if (!drawer || !trigger) return;
			if (open) {
				drawer.removeAttribute('hidden');
				drawer.setAttribute('aria-hidden', 'false');
				trigger.setAttribute('aria-expanded', 'true');
				if (iconBars) iconBars.style.display = 'none';
				if (iconClose) iconClose.style.display = 'block';
				document.body.style.overflow = 'hidden';
			} else {
				drawer.setAttribute('hidden', '');
				drawer.setAttribute('aria-hidden', 'true');
				trigger.setAttribute('aria-expanded', 'false');
				if (iconBars) iconBars.style.display = 'block';
				if (iconClose) iconClose.style.display = 'none';
				document.body.style.overflow = '';
			}
		}

		trigger.addEventListener('click', () => {
			const isCurrentlyOpen = !drawer.hasAttribute('hidden');
			setMenuOpen(!isCurrentlyOpen);
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !drawer.hasAttribute('hidden')) {
				setMenuOpen(false);
			}
		});

		drawer.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});
	}
</script>

<style>
	.header {
		display: flex;
		gap: var(--ap-space-3);
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
	}

	.header-left {
		display: flex;
		align-items: center;
		min-width: 0;
		gap: var(--ap-space-3);
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: var(--ap-space-2);
		flex-shrink: 0;
	}

	.title-wrapper {
		overflow: clip;
		padding: var(--ap-space-1);
		margin: calc(-1 * var(--ap-space-1));
		min-width: 0;
		flex-shrink: 0;
	}

	/* Top navigation: strictly hidden on mobile/tablet; flex on desktop */
	.top-nav {
		display: none;
	}

	@media (min-width: 64rem) {
		.top-nav {
			display: flex;
			align-items: center;
			gap: var(--ap-space-1);
			margin-inline-start: var(--ap-space-2);
		}
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: var(--ap-space-2);
		padding: var(--ap-space-1) var(--ap-space-3);
		border-radius: var(--ap-radius-md);
		font-size: var(--ap-font-sm);
		font-weight: 500;
		color: var(--ap-text-secondary);
		text-decoration: none;
		transition: all var(--ap-transition-fast);
		border: 1px solid transparent;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--ap-call);
		background: var(--ap-call-subtle);
		border-color: var(--ap-border-subtle);
	}

	.nav-link.active {
		color: var(--ap-call);
		font-weight: 600;
		background: var(--ap-call-subtle);
		border-color: var(--ap-border-default);
	}

	.nav-badge {
		font-size: var(--ap-font-xs);
		font-family: var(--ap-font-mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 1px var(--ap-space-2);
		border-radius: var(--ap-radius-full);
		background: var(--ap-response-subtle);
		color: var(--ap-response);
		border: 1px solid var(--ap-border-subtle);
	}

	.search-wrapper {
		display: flex;
		align-items: center;
	}

	@media (min-width: 50rem) {
		.search-wrapper {
			min-width: 12rem;
			max-width: 18rem;
		}
	}

	/* Right group (Social icons + Theme selector): hidden on mobile; flex on tablet & desktop */
	.right-group {
		display: none;
		align-items: center;
		gap: var(--ap-space-3);
	}

	@media (min-width: 50rem) {
		.right-group {
			display: flex;
		}
	}

	.social-icons {
		gap: var(--ap-space-3);
		align-items: center;
	}

	.social-icons::after {
		content: '';
		height: var(--ap-space-5);
		border-inline-end: 1px solid var(--ap-border-subtle);
	}

	/* Mobile menu toggle button: flex on mobile/tablet; hidden on desktop */
	.mobile-menu-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--ap-radius-md);
		border: 1px solid var(--ap-border-subtle);
		background: var(--ap-surface-elevated);
		color: var(--ap-text-primary);
		cursor: pointer;
		transition: all var(--ap-transition-fast);
		padding: 0;
		flex-shrink: 0;
	}

	.mobile-menu-btn:hover {
		border-color: var(--ap-call);
		color: var(--ap-call);
		background: var(--ap-call-subtle);
	}

	@media (min-width: 64rem) {
		.mobile-menu-btn {
			display: none;
		}
	}

	/* Full viewport drawer for mobile splash navigation */
	.mobile-nav-drawer {
		position: fixed;
		top: var(--sl-nav-height);
		inset-inline: 0;
		bottom: 0;
		background: var(--ap-surface-base);
		border-top: 1px solid var(--ap-border-subtle);
		padding: var(--ap-space-5) var(--ap-space-4);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		z-index: var(--sl-z-index-menu, 5);
		overflow-y: auto;
		animation: mobileDrawerFadeIn var(--ap-transition-fast) ease-out;
	}

	.mobile-nav-drawer[hidden] {
		display: none !important;
	}

	@keyframes mobileDrawerFadeIn {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.mobile-nav-list {
		display: flex;
		flex-direction: column;
		gap: var(--ap-space-2);
	}

	.mobile-nav-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--ap-space-3) var(--ap-space-4);
		border-radius: var(--ap-radius-lg);
		font-size: var(--ap-font-base);
		font-weight: 500;
		color: var(--ap-text-primary);
		text-decoration: none;
		border: 1px solid var(--ap-border-subtle);
		background: var(--ap-surface-card);
		transition: all var(--ap-transition-fast);
	}

	.mobile-nav-link:hover,
	.mobile-nav-link.active {
		border-color: var(--ap-call);
		background: var(--ap-call-subtle);
		color: var(--ap-call);
		font-weight: 600;
	}

	.mobile-nav-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: var(--ap-space-4);
		margin-top: var(--ap-space-6);
		border-top: 1px solid var(--ap-border-subtle);
	}

	.mobile-social {
		display: flex;
		align-items: center;
		gap: var(--ap-space-3);
	}
</style>
