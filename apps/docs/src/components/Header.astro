---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { primaryNav, isActive } from '../lib/nav';

const currentPath = Astro.url.pathname;
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header">
	<div class="header-left">
		<a href="/" class="brand">
			<img src="/favicon.svg" alt="" width="24" height="24" />
			<span>Antiphony</span>
		</a>

		<nav class="top-nav print:hidden" aria-label="Main Navigation">
			{primaryNav.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { active: isActive(item.href, currentPath) }]}
					aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>
	</div>

	<div class="header-right">
		<div class="search-wrapper print:hidden">
			<Search {...Astro.props} />
		</div>

		<div class="right-group print:hidden">
			<a href="https://github.com/bbthorson/antiphony" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="github">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
				</svg>
			</a>
			<ThemeToggle />
		</div>

		<!-- Splash pages have no sidebar, so they get their own menu button. -->
		{!hasSidebar && (
			<button
				type="button"
				class="mobile-menu-btn print:hidden"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="mobile-nav-drawer"
				id="mobile-menu-trigger"
			>
				<svg class="menu-icon-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		)}
	</div>
</div>

{!hasSidebar && (
	<div id="mobile-nav-drawer" class="mobile-nav-drawer print:hidden" hidden aria-hidden="true">
		<nav class="mobile-nav-list" aria-label="Mobile Navigation">
			{primaryNav.map((item) => (
				<a
					href={item.href}
					class:list={['mobile-nav-link', { active: isActive(item.href, currentPath) }]}
					aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>
		<div class="mobile-nav-footer">
			<a href="https://github.com/bbthorson/antiphony" target="_blank" rel="noopener noreferrer">GitHub</a>
			<ThemeToggle />
		</div>
	</div>
)}

<script>
	const trigger = document.getElementById('mobile-menu-trigger');
	const drawer = document.getElementById('mobile-nav-drawer');

	if (trigger && drawer) {
		const iconBars = trigger.querySelector<HTMLElement>('.menu-icon-bars');
		const iconClose = trigger.querySelector<HTMLElement>('.menu-icon-close');

		const setMenuOpen = (open: boolean) => {
			drawer.toggleAttribute('hidden', !open);
			drawer.setAttribute('aria-hidden', String(!open));
			trigger.setAttribute('aria-expanded', String(open));
			if (iconBars) iconBars.style.display = open ? 'none' : 'block';
			if (iconClose) iconClose.style.display = open ? 'block' : 'none';
			document.body.style.overflow = open ? 'hidden' : '';
		};

		trigger.addEventListener('click', () => setMenuOpen(drawer.hasAttribute('hidden')));
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !drawer.hasAttribute('hidden')) setMenuOpen(false);
		});
		drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
	}
</script>

<style>
	.header {
		display: flex;
		gap: 16px;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 28px;
		min-width: 0;
		height: 100%;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: none;
		text-decoration: none;
		color: var(--ap-text-primary);
		font-family: var(--ap-font-display);
		font-weight: 600;
		font-size: 18px;
		letter-spacing: -0.015em;
	}

	.brand img {
		display: block;
		width: 24px;
		height: 24px;
	}

	/* The primary nav: underline tabs that sit on the header's bottom edge. */
	.top-nav {
		display: none;
	}

	@media (min-width: 72rem) {
		.top-nav {
			display: flex;
			align-items: stretch;
			gap: 22px;
			height: calc(100% + 2 * var(--sl-nav-pad-y));
			margin-block: calc(-1 * var(--sl-nav-pad-y));
		}
	}

	.nav-link {
		display: flex;
		align-items: center;
		font-size: 14px;
		font-weight: 500;
		color: var(--ap-text-secondary);
		text-decoration: none;
		white-space: nowrap;
		box-shadow: inset 0 -2px 0 transparent;
		transition: color var(--ap-transition-fast), box-shadow var(--ap-transition-fast);
	}

	.nav-link:hover {
		color: var(--ap-text-primary);
	}

	.nav-link.active {
		color: var(--ap-text-primary);
		box-shadow: inset 0 -2px 0 var(--ap-call);
	}

	/* Restyle Starlight's search trigger as the quiet "Search docs ⌘K" field. */
	.search-wrapper {
		display: flex;
		align-items: center;
	}

	.search-wrapper :global(button[data-open-modal]) {
		height: 34px;
		border: 1px solid var(--ap-border-default);
		border-radius: var(--ap-radius-md);
		background: transparent;
		color: var(--ap-text-muted);
		font-size: 13px;
		box-shadow: none;
	}

	@media (min-width: 45rem) {
		.search-wrapper :global(button[data-open-modal]) {
			width: 220px;
			padding: 0 8px 0 12px;
		}
	}

	.search-wrapper :global(button[data-open-modal]:hover) {
		border-color: var(--ap-border-strong);
		color: var(--ap-text-secondary);
	}

	.search-wrapper :global(button[data-open-modal] kbd) {
		font-family: var(--ap-font-mono);
		font-size: 11px;
		background: transparent;
		border-color: var(--ap-border-default);
		color: var(--ap-text-muted);
	}

	.right-group {
		display: none;
		align-items: center;
		gap: 12px;
	}

	@media (min-width: 50rem) {
		.right-group {
			display: flex;
		}
	}

	.github {
		display: flex;
		color: var(--ap-text-secondary);
	}

	.github:hover {
		color: var(--ap-text-primary);
	}

	.mobile-menu-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		flex-shrink: 0;
		border-radius: var(--ap-radius-md);
		border: 1px solid var(--ap-border-default);
		background: transparent;
		color: var(--ap-text-primary);
		cursor: pointer;
	}

	@media (min-width: 72rem) {
		.mobile-menu-btn {
			display: none;
		}
	}

	.mobile-nav-drawer {
		position: fixed;
		top: var(--sl-nav-height);
		inset-inline: 0;
		bottom: 0;
		background: var(--ap-surface-base);
		border-top: 1px solid var(--ap-border-subtle);
		padding: 20px 16px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		z-index: var(--sl-z-index-menu, 5);
		overflow-y: auto;
	}

	.mobile-nav-drawer[hidden] {
		display: none !important;
	}

	.mobile-nav-list {
		display: flex;
		flex-direction: column;
	}

	.mobile-nav-link {
		padding: 14px 4px;
		border-bottom: 1px solid var(--ap-border-subtle);
		font-size: 16px;
		font-weight: 500;
		color: var(--ap-text-primary);
		text-decoration: none;
		box-shadow: inset 2px 0 0 transparent;
	}

	.mobile-nav-link.active {
		padding-inline-start: 12px;
		box-shadow: inset 2px 0 0 var(--ap-call);
		font-weight: 600;
	}

	.mobile-nav-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 16px;
		margin-top: 24px;
		border-top: 1px solid var(--ap-border-subtle);
		font-size: 14px;
		font-weight: 600;
	}
</style>
