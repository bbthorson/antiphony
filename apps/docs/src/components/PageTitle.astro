---
const PAGE_TITLE_ID = '_top';

const { entry, sidebar } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';

type Entry = (typeof sidebar)[number];

/** The label of the sidebar group that holds the current page, if any. */
function groupOf(entries: Entry[], parent?: string): string | undefined {
	for (const e of entries) {
		if (e.type === 'link' && e.isCurrent) return parent;
		if (e.type === 'group') {
			const found = groupOf(e.entries, e.label);
			if (found) return found;
		}
	}
	return undefined;
}

const eyebrow = entry.data.eyebrow ?? groupOf(sidebar);
---

{!isSplash && (
	<div class="page-title">
		{eyebrow && <div class="eyebrow">{eyebrow}</div>}
		<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
	</div>
)}

<style>
	.page-title {
		margin-top: 16px;
	}

	.eyebrow {
		margin-bottom: 14px;
		font-family: var(--ap-font-mono);
		font-size: 12px;
		color: var(--ap-text-muted);
	}

	h1 {
		margin: 0;
		font-family: var(--ap-font-display);
		font-size: 40px;
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.1;
		color: var(--ap-text-primary);
	}
</style>
