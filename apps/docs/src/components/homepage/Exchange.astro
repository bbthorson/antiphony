---
/**
 * One call and its response, set like an antiphon: ℣ marks the call (a
 * question a reader would ask), ℟ marks the answer. Exchanges sit inside a
 * <Conversation>, which draws the thread line their marks hang on.
 */
interface Props {
	call: string;
	id?: string;
}

const { call, id } = Astro.props;
---

<section class="exchange" id={id}>
	<div class="turn">
		<span class="mark mark-call" aria-hidden="true">℣</span>
		<h2 class="call">{call}</h2>
	</div>
	<div class="turn turn-response">
		<span class="mark mark-response" aria-hidden="true">℟</span>
		<div class="response"><slot /></div>
	</div>
</section>

<style>
	.exchange {
		margin: 0 0 var(--ap-space-12);
	}

	.turn {
		display: grid;
		grid-template-columns: var(--thread-gutter) minmax(0, 1fr);
		align-items: start;
	}

	.turn-response {
		margin-top: var(--ap-space-4);
	}

	.mark {
		justify-self: center;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--ap-radius-full);
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-sm);
		font-weight: 600;
		line-height: 1;
		/* Sits on the thread line, so it needs an opaque field behind it. */
		position: relative;
		z-index: 1;
	}

	.mark-call {
		background: var(--ap-call);
		color: var(--ap-text-inverse);
		margin-top: 0.2em;
	}

	/* Ink on coral, not white: white-on-coral fails WCAG AA (see brand.css). */
	.mark-response {
		background: var(--ap-response);
		color: var(--ap-neutral-900);
	}

	.call {
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-2xl);
		font-weight: 700;
		line-height: var(--ap-leading-tight);
		color: var(--ap-text-primary);
		margin: 0;
	}

	.response :global(.lead) {
		font-size: var(--ap-font-base);
		line-height: var(--ap-leading-relaxed);
		color: var(--ap-text-secondary);
		max-width: 44rem;
		margin: 0.15rem 0 var(--ap-space-6);
	}

	/* With JS, a response arrives a beat after its call scrolls into view.
	   Without JS, or with reduced motion, everything is simply there. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html.ap-answering) .exchange:not(.answered) .turn-response {
			opacity: 0;
			transform: translateY(0.5rem);
		}

		.turn-response {
			transition:
				opacity 400ms ease-out 250ms,
				transform 400ms ease-out 250ms;
		}
	}

	@media (max-width: 48rem) {
		.exchange {
			margin-bottom: var(--ap-space-10);
		}

		.call {
			font-size: var(--ap-font-xl);
		}
	}
</style>
