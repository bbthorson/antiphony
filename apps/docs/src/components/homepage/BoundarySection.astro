---
---

<section class="boundary-section">
	<div class="boundary-grid">
		<div class="boundary-card core-card">
			<div class="boundary-badge badge-core">Antiphony</div>
			<ul class="boundary-list">
				<li>
					<strong>Lexicons.</strong> <code>dev.antiphony.*</code> records for audio posts, replies, and transcripts.
				</li>
				<li>
					<strong>REST API.</strong> Audio upload, post and reply creation, and playback URLs.
				</li>
				<li>
					<strong>Processing.</strong> Transcription, denoising, silence trimming, waveforms, and mp3 renditions, each opt-in.
				</li>
				<li>
					<strong>Tenancy.</strong> Every post is scoped to the app that created it (<code>originAppId</code>).
				</li>
			</ul>
		</div>

		<div class="boundary-card app-card">
			<div class="boundary-badge badge-app">Your app</div>
			<ul class="boundary-list">
				<li>
					<strong>Accounts.</strong> Profiles, sign-in, sessions, and OAuth.
				</li>
				<li>
					<strong>Product.</strong> UI, feeds, ranking, moderation, and community rules.
				</li>
				<li>
					<strong>Teams and billing.</strong> Workspaces, roles, permissions, and subscriptions.
				</li>
				<li>
					<strong>Connectors.</strong> Telephony, broadcast feeds, and your own webhooks.
				</li>
			</ul>
		</div>
	</div>
</section>

<style>
	.boundary-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--ap-space-4);
	}

	/* Starlight spaces sibling markdown blocks apart; grid cells shouldn't be. */
	.boundary-grid > .boundary-card {
		margin-top: 0;
	}

	.boundary-card {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		padding: var(--ap-space-5);
		box-shadow: var(--ap-shadow-md);
	}

	.core-card {
		border-top: 4px solid var(--ap-call);
	}

	.app-card {
		border-top: 4px solid var(--ap-response);
	}

	.boundary-badge {
		display: inline-block;
		font-size: var(--ap-font-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: var(--ap-space-1) var(--ap-space-3);
		border-radius: var(--ap-radius-full);
		margin-bottom: var(--ap-space-4);
	}

	.badge-core {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
		border: 1px solid var(--ap-border-subtle);
	}

	.badge-app {
		background: var(--ap-response-subtle);
		color: var(--ap-response);
		border: 1px solid var(--ap-border-subtle);
	}

	.boundary-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--ap-space-3);
	}

	.boundary-list li {
		font-size: var(--ap-font-sm);
		color: var(--ap-text-secondary);
		line-height: var(--ap-leading-relaxed);
	}

	.boundary-list strong {
		color: var(--ap-text-primary);
	}

	@media (max-width: 48rem) {
		.boundary-card {
			padding: var(--ap-space-4);
		}
	}
</style>
