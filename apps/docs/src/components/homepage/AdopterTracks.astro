---
const tracks = [
	{
		title: "Protocol Adopters",
		badge: "ATProto Lexicons",
		badgeType: "call",
		desc: "Integrate dev.antiphony.* records into your AppView or PDS. Give your users sovereign, portable audio posts and threaded voice replies that transcend any single platform.",
		link: "/lexicons/overview/",
		linkText: "Explore Lexicon Specs →",
		icon: "🌐",
	},
	{
		title: "App Builders",
		badge: "Capture Kit",
		badgeType: "response",
		desc: "Add voice capture to your client with @antiphony/capture-kit. Headless React hooks for mic access, waveform visualization, and resilient audio upload in just a few lines of code.",
		link: "/build-your-own/overview/",
		linkText: "Build Your App →",
		icon: "🎙️",
	},
	{
		title: "Self-Hosters",
		badge: "Infrastructure",
		badgeType: "neutral",
		desc: "Deploy Antiphony's open core on Cloudflare Workers and Neon Postgres. Enjoy zero VM maintenance, edge latency worldwide, and pluggable AI transcription pipelines.",
		link: "/self-hosting/quick-start/",
		linkText: "Self-Host in 5 Minutes →",
		icon: "⚡",
	},
];
---

<div class="tracks-container">
	<div class="tracks-header">
		<span class="tracks-tag">Adopter Pathways</span>
		<h2 class="tracks-title">Choose Your Starting Point</h2>
		<p class="tracks-desc">
			Whether you're defining protocol schemas, building interactive user experiences, or operating edge infrastructure, Antiphony gives you modular foundations.
		</p>
	</div>

	<div class="tracks-grid">
		{tracks.map((track) => (
			<div class="track-card">
				<div class="card-top">
					<span class="track-icon">{track.icon}</span>
					<span class:list={['track-badge', `badge-${track.badgeType}`]}>
						{track.badge}
					</span>
				</div>
				<h3 class="track-title">{track.title}</h3>
				<p class="track-desc">{track.desc}</p>
				<a href={track.link} class="track-link">
					{track.linkText}
				</a>
			</div>
		))}
	</div>
</div>

<style>
	.tracks-container {
		max-width: 56rem;
		margin: var(--ap-space-12) auto;
		padding: 0 var(--ap-space-4);
	}

	.tracks-header {
		text-align: center;
		margin-bottom: var(--ap-space-8);
	}

	.tracks-tag {
		font-size: var(--ap-font-xs);
		font-weight: 600;
		color: var(--ap-call);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		background: var(--ap-call-subtle);
		padding: 2px var(--ap-space-3);
		border-radius: var(--ap-radius-full);
	}

	.tracks-title {
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-2xl);
		font-weight: 700;
		color: var(--ap-text-primary);
		margin: var(--ap-space-3) 0 var(--ap-space-2);
	}

	.tracks-desc {
		font-size: var(--ap-font-base);
		color: var(--ap-text-secondary);
		max-width: 40rem;
		margin: 0 auto;
		line-height: var(--ap-leading-relaxed);
	}

	.tracks-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--ap-space-4);
	}

	.track-card {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		padding: var(--ap-space-5);
		display: flex;
		flex-direction: column;
		box-shadow: var(--ap-shadow-md);
		transition: all var(--ap-transition-fast);
	}

	.track-card:hover {
		border-color: var(--ap-call);
		box-shadow: var(--ap-shadow-call-glow);
		transform: translateY(-2px);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--ap-space-3);
	}

	.track-icon {
		font-size: var(--ap-font-2xl);
	}

	.track-badge {
		font-size: var(--ap-font-xs);
		font-weight: 600;
		padding: 2px var(--ap-space-2);
		border-radius: var(--ap-radius-sm);
	}

	.badge-call {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
		border: 1px solid var(--ap-border-subtle);
	}

	.badge-response {
		background: var(--ap-response-subtle);
		color: var(--ap-response);
		border: 1px solid var(--ap-border-subtle);
	}

	.badge-neutral {
		background: var(--ap-surface-sunken);
		color: var(--ap-text-secondary);
		border: 1px solid var(--ap-border-subtle);
	}

	.track-title {
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-lg);
		font-weight: 700;
		color: var(--ap-text-primary);
		margin: 0 0 var(--ap-space-2);
	}

	.track-desc {
		font-size: var(--ap-font-sm);
		color: var(--ap-text-secondary);
		line-height: var(--ap-leading-relaxed);
		margin: 0 0 var(--ap-space-4);
		flex: 1;
	}

	.track-link {
		font-size: var(--ap-font-sm);
		font-weight: 600;
		color: var(--ap-call);
		text-decoration: none;
		transition: color var(--ap-transition-fast);
	}

	.track-link:hover {
		color: var(--ap-response);
		text-decoration: none;
	}
</style>
