---
const tracks = [
	{
		title: "Use the lexicons",
		desc: "Read and write dev.antiphony.* records from your own AppView or PDS tooling. The audio embed and the post/reply shape are the contract every Antiphony app shares.",
		link: "/lexicons/overview/",
		linkText: "Read the lexicons →",
	},
	{
		title: "Build an app",
		desc: "Record in the browser with @antiphony/capture-kit, then upload and create posts through the REST API. The kit hands you a Blob; the upload is yours.",
		link: "/build-your-own/overview/",
		linkText: "Build an app →",
	},
	{
		title: "Run your own",
		desc: "Deploy the API to Cloudflare Workers with Neon Postgres and R2. The processing providers are adapters you can swap.",
		link: "/self-hosting/quick-start/",
		linkText: "Quick start →",
	},
];
---

<div class="tracks-container">
	<div class="tracks-header">
		<h2 class="tracks-title">Where to start</h2>
	</div>

	<div class="tracks-grid">
		{tracks.map((track) => (
			<div class="track-card">
				<h3 class="track-title">{track.title}</h3>
				<p class="track-desc">{track.desc}</p>
				<a href={track.link} class="track-link">
					{track.linkText}
				</a>
			</div>
		))}
	</div>
</div>

<style>
	.tracks-container {
		max-width: 56rem;
		margin: var(--ap-space-12) auto;
		padding: 0 var(--ap-space-4);
	}

	.tracks-header {
		text-align: center;
		margin-bottom: var(--ap-space-8);
	}

	.tracks-title {
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-2xl);
		font-weight: 700;
		color: var(--ap-text-primary);
		margin: 0 0 var(--ap-space-2);
	}

	.tracks-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--ap-space-4);
	}

	.track-card {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		padding: var(--ap-space-5);
		display: flex;
		flex-direction: column;
		box-shadow: var(--ap-shadow-md);
	}

	.track-title {
		font-family: var(--ap-font-display);
		font-size: var(--ap-font-lg);
		font-weight: 700;
		color: var(--ap-text-primary);
		margin: 0 0 var(--ap-space-2);
	}

	.track-desc {
		font-size: var(--ap-font-sm);
		color: var(--ap-text-secondary);
		line-height: var(--ap-leading-relaxed);
		margin: 0 0 var(--ap-space-4);
		flex: 1;
	}

	.track-link {
		font-size: var(--ap-font-sm);
		font-weight: 600;
		color: var(--ap-call);
		text-decoration: none;
		transition: color var(--ap-transition-fast);
	}

	.track-link:hover {
		color: var(--ap-response);
		text-decoration: none;
	}

	@media (max-width: 48rem) {
		.tracks-container {
			margin: var(--ap-space-8) auto;
		}

		.track-card {
			padding: var(--ap-space-4);
		}
	}
</style>
