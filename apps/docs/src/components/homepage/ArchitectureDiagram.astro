---
---

<div class="arch-container">
	<div class="diagram-grid">
		<!-- In: whatever the calling app puts in front of the API -->
		<div class="tier-card ingress-tier">
			<div class="tier-badge">In</div>
			<div class="tier-items">
				<div class="node-pill">
					<div>
						<div class="node-title">@antiphony/capture-kit</div>
						<div class="node-sub">Recording in the browser (React)</div>
					</div>
				</div>
				<div class="node-pill">
					<div>
						<div class="node-title">Your app's backend</div>
						<div class="node-sub">Uploads audio, creates posts over REST</div>
					</div>
				</div>
				<div class="node-pill">
					<div>
						<div class="node-title">Your connectors</div>
						<div class="node-sub">A phone line, for example. The app runs it.</div>
					</div>
				</div>
			</div>
		</div>

		<div class="tier-flow-arrow" aria-hidden="true">↓</div>

		<!-- Antiphony itself -->
		<div class="tier-card hub-tier">
			<div class="tier-badge core-badge">Antiphony</div>
			<div class="core-hub-content">
				<div class="core-box">
					<div class="core-name">Cloudflare Workers</div>
					<div class="core-desc">Hono API</div>
				</div>
				<div class="core-subgrid">
					<div class="sub-core-box">
						<span class="sub-name">Neon Postgres</span>
						<span class="sub-desc">Records and indexes</span>
					</div>
					<div class="sub-core-box">
						<span class="sub-name">Cloudflare R2</span>
						<span class="sub-desc">Audio, stored by CID</span>
					</div>
				</div>
				<div class="pipeline-row">
					<div class="pipeline-badge">Opt-in processing</div>
					<div class="pipeline-flow">
						<span>Denoise (ElevenLabs)</span>
						<span class="flow-arrow">→</span>
						<span>Trim (ffmpeg)</span>
						<span class="flow-arrow">→</span>
						<span>Transcript (Whisper) and waveform</span>
					</div>
				</div>
			</div>
		</div>

		<div class="tier-flow-arrow" aria-hidden="true">↓</div>

		<!-- Out -->
		<div class="tier-card egress-tier">
			<div class="tier-badge">Out</div>
			<div class="tier-items">
				<div class="node-pill">
					<div>
						<div class="node-title">REST and XRPC</div>
						<div class="node-sub"><code>/api/v1/*</code> and <code>/xrpc/dev.antiphony.*</code></div>
					</div>
				</div>
				<div class="node-pill">
					<div>
						<div class="node-title">Webhooks</div>
						<div class="node-sub">Signed, as each processing stage finishes</div>
					</div>
				</div>
				<div class="node-pill">
					<div>
						<div class="node-title">Apps</div>
						<div class="node-sub">Vox Pop, Bardcast, yours</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.diagram-grid {
		display: grid;
		grid-template-columns: 1fr 1.35fr 1fr;
		gap: var(--ap-space-4);
		align-items: stretch;
	}

	.tier-card {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		padding: var(--ap-space-4);
		display: flex;
		flex-direction: column;
		box-shadow: var(--ap-shadow-md);
		position: relative;
	}

	.hub-tier {
		border-color: var(--ap-call);
		background: var(--ap-surface-elevated);
	}

	.tier-badge {
		align-self: center;
		font-size: var(--ap-font-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 2px var(--ap-space-3);
		border-radius: var(--ap-radius-full);
		background: var(--ap-surface-sunken);
		color: var(--ap-text-secondary);
		border: 1px solid var(--ap-border-subtle);
		margin-bottom: var(--ap-space-4);
	}

	.core-badge {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
		border-color: var(--ap-border-default);
	}

	.tier-items {
		display: flex;
		flex-direction: column;
		gap: var(--ap-space-3);
		height: 100%;
		justify-content: space-around;
	}

	.node-pill {
		display: flex;
		align-items: center;
		gap: var(--ap-space-3);
		background: var(--ap-surface-sunken);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-md);
		padding: var(--ap-space-2) var(--ap-space-3);
		transition: all var(--ap-transition-fast);
	}


	.node-title {
		font-size: var(--ap-font-xs);
		font-weight: 600;
		color: var(--ap-text-primary);
		font-family: var(--ap-font-mono);
	}

	.node-sub {
		font-size: var(--ap-font-xs);
		color: var(--ap-text-muted);
	}

	.core-hub-content {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: var(--ap-space-3);
	}

	.core-box {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-default);
		border-radius: var(--ap-radius-md);
		padding: var(--ap-space-3);
		text-align: center;
	}

	.core-name {
		font-size: var(--ap-font-sm);
		font-weight: 700;
		color: var(--ap-call);
	}

	.core-desc {
		font-size: var(--ap-font-xs);
		color: var(--ap-text-secondary);
	}

	.core-subgrid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--ap-space-2);
	}

	.sub-core-box {
		background: var(--ap-surface-sunken);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-md);
		padding: var(--ap-space-2);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
	}

	.sub-name {
		font-size: var(--ap-font-xs);
		font-weight: 600;
		color: var(--ap-text-primary);
	}

	.sub-desc {
		font-size: var(--ap-font-xs);
		color: var(--ap-text-muted);
	}

	.pipeline-row {
		background: var(--ap-surface-sunken);
		border: 1px dashed var(--ap-border-default);
		border-radius: var(--ap-radius-md);
		padding: var(--ap-space-2) var(--ap-space-3);
		text-align: center;
		margin-top: auto;
	}

	.pipeline-badge {
		font-size: var(--ap-font-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-weight: 700;
		color: var(--ap-response);
		margin-bottom: 2px;
	}

	.pipeline-flow {
		font-size: var(--ap-font-xs);
		font-family: var(--ap-font-mono);
		color: var(--ap-text-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--ap-space-1);
	}

	.flow-arrow {
		color: var(--ap-response);
	}

	.tier-flow-arrow {
		display: none;
		align-items: center;
		justify-content: center;
		font-size: var(--ap-font-lg);
		color: var(--ap-call);
		font-weight: 700;
		padding: var(--ap-space-1) 0;
	}

	@media (max-width: 58rem) {
		.diagram-grid {
			grid-template-columns: 1fr;
			gap: var(--ap-space-2);
		}

		.tier-flow-arrow {
			display: flex;
		}

		.tier-items {
			gap: var(--ap-space-2);
		}
	}
</style>
