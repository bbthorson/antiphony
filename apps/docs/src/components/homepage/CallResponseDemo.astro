---
const mockCallWaveform = [12, 28, 45, 60, 75, 90, 85, 60, 40, 55, 70, 80, 65, 45, 30, 50, 75, 95, 80, 60, 45, 30, 20];
const mockResponseWaveform = [18, 35, 50, 70, 88, 92, 75, 55, 65, 80, 85, 70, 50, 40, 60, 82, 90, 75, 50, 35, 25];
---

<div class="demo-wrapper">
	<div class="thread-container">
		<!-- Card 1: The Call (Voice 1 / Indigo) -->
		<div class="audio-card call-card" id="call-card">
			<div class="card-meta">
				<div class="actor-info">
					<div class="actor-avatar call-avatar">A</div>
					<div class="actor-text">
						<div class="actor-name">Alice <span class="actor-handle">@alice.bsky.social</span></div>
						<div class="record-badge" title="at://did:plc:alice.../dev.antiphony.audio.post/3k6w">at://did:plc:alice.../dev.antiphony.audio.post/3k6w</div>
					</div>
				</div>
				<span class="type-pill pill-call">Prompt</span>
			</div>

			<p class="card-prompt">
				First-job advice?
			</p>

			<div class="player-widget" data-player="call">
				<button type="button" class="play-btn play-call" aria-label="Play prompt audio" aria-pressed="false" data-play-btn="call">
					<svg class="play-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<polygon points="5 3 19 12 5 21 5 3"/>
					</svg>
					<svg class="pause-icon sl-hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<rect x="6" y="4" width="4" height="16"/>
						<rect x="14" y="4" width="4" height="16"/>
					</svg>
				</button>

				<div class="waveform-container" data-waveform="call">
					{mockCallWaveform.map((peak, idx) => (
						<div
							class="waveform-bar"
							style={`height: ${peak}%`}
							data-index={idx}
						/>
					))}
				</div>

				<span class="duration-display" data-time="call">0:00 / 0:03</span>
			</div>

			<div class="transcript-preview">
				<span class="transcript-label">Transcript:</span>
				"What's the best advice you got in your first year of work?"
			</div>
		</div>

		<!-- Thread Connector Line -->
		<div class="thread-connector">
			<div class="connector-line"></div>
			<div class="connector-node"></div>
		</div>

		<!-- Card 2: The Response (Voice 2 / Coral) -->
		<div class="audio-card response-card" id="response-card">
			<div class="card-meta">
				<div class="actor-info">
					<div class="actor-avatar response-avatar">B</div>
					<div class="actor-text">
						<div class="actor-name">Bob <span class="actor-handle">@bob.audio.social</span></div>
						<div class="record-badge" title="reply to at://did:plc:alice.../dev.antiphony.audio.post/3k6w">reply to at://did:plc:alice.../3k6w</div>
					</div>
				</div>
				<span class="type-pill pill-response">Reply</span>
			</div>

			<div class="player-widget" data-player="response">
				<button type="button" class="play-btn play-response" aria-label="Play reply audio" aria-pressed="false" data-play-btn="response">
					<svg class="play-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<polygon points="5 3 19 12 5 21 5 3"/>
					</svg>
					<svg class="pause-icon sl-hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<rect x="6" y="4" width="4" height="16"/>
						<rect x="14" y="4" width="4" height="16"/>
					</svg>
				</button>

				<div class="waveform-container" data-waveform="response">
					{mockResponseWaveform.map((peak, idx) => (
						<div
							class="waveform-bar bar-response"
							style={`height: ${peak}%`}
							data-index={idx}
						/>
					))}
				</div>

				<span class="duration-display" data-time="response">0:00 / 0:04</span>
			</div>

			<div class="transcript-preview">
				<span class="transcript-label">Transcript:</span>
				"Write down why you made a decision, not just what you decided. Six months later you won't remember."
			</div>
		</div>
	</div>
</div>

<script>
	// The two cards "speak" when played: a wordless, voice-like murmur made
	// with Web Audio, no audio files. Alice's phrase rises at the end like a
	// question; Bob's falls like an answer. Playing Alice's card cues Bob's
	// reply when hers finishes, which is the whole product in five seconds.

	type Voice = {
		syllables: number;
		seconds: number;
		/** Pitch in Hz at the start and end of the phrase. */
		from: number;
		to: number;
	};

	const VOICES: Record<'call' | 'response', Voice> = {
		call: { syllables: 7, seconds: 2.4, from: 210, to: 320 },
		response: { syllables: 10, seconds: 3.2, from: 150, to: 105 },
	};

	let ctx: AudioContext | null = null;
	let current: { stop: () => void } | null = null;

	function speak(voice: Voice, onEnd: () => void) {
		ctx ??= new AudioContext();
		const t0 = ctx.currentTime + 0.05;
		const osc = ctx.createOscillator();
		const filter = ctx.createBiquadFilter();
		const gain = ctx.createGain();

		osc.type = 'triangle';
		filter.type = 'lowpass';
		filter.frequency.value = 900;
		gain.gain.value = 0;

		// Intonation: glide from `from` to `to`, wobbling a little per syllable.
		const steps = voice.syllables * 4;
		const curve = new Float32Array(steps);
		for (let i = 0; i < steps; i++) {
			const t = i / (steps - 1);
			const wobble = 1 + 0.06 * Math.sin(i * 1.7);
			curve[i] = (voice.from + (voice.to - voice.from) * t * t) * wobble;
		}
		osc.frequency.setValueCurveAtTime(curve, t0, voice.seconds);

		// Syllables: a soft swell and fall for each one.
		const per = voice.seconds / voice.syllables;
		for (let i = 0; i < voice.syllables; i++) {
			const at = t0 + i * per;
			gain.gain.setValueAtTime(0, at);
			gain.gain.linearRampToValueAtTime(0.12, at + per * 0.3);
			gain.gain.linearRampToValueAtTime(0.02, at + per * 0.85);
		}
		gain.gain.linearRampToValueAtTime(0, t0 + voice.seconds);

		osc.connect(filter).connect(gain).connect(ctx.destination);
		osc.start(t0);
		osc.stop(t0 + voice.seconds + 0.05);

		let stopped = false;
		osc.onended = () => {
			if (!stopped) onEnd();
		};
		return {
			stop() {
				stopped = true;
				osc.stop();
			},
		};
	}

	function setupCard(type: 'call' | 'response', next?: () => void) {
		const btn = document.querySelector(`[data-play-btn="${type}"]`);
		const waveform = document.querySelector(`[data-waveform="${type}"]`);
		const timeDisplay = document.querySelector(`[data-time="${type}"]`);
		if (!btn || !waveform || !timeDisplay) return () => {};

		const voice = VOICES[type];
		const bars = waveform.querySelectorAll('.waveform-bar');
		const total = Math.ceil(voice.seconds);
		let raf = 0;

		function render(progress: number) {
			const lit = Math.round(progress * bars.length);
			bars.forEach((bar, i) => bar.classList.toggle('played', i < lit));
			const sec = Math.min(total, Math.floor(progress * voice.seconds));
			timeDisplay!.textContent = `0:0${sec} / 0:0${total}`;
		}

		function setPlaying(on: boolean) {
			btn!.querySelector('.play-icon')?.classList.toggle('sl-hidden', on);
			btn!.querySelector('.pause-icon')?.classList.toggle('sl-hidden', !on);
			btn!.setAttribute('aria-pressed', String(on));
		}

		function stop() {
			cancelAnimationFrame(raf);
			setPlaying(false);
		}

		function play(thenNext: boolean) {
			current?.stop();
			setPlaying(true);
			const started = performance.now();
			const tick = () => {
				const progress = Math.min(1, (performance.now() - started) / (voice.seconds * 1000));
				render(progress);
				if (progress < 1) raf = requestAnimationFrame(tick);
			};
			tick();
			const handle = speak(voice, () => {
				stop();
				current = null;
				if (thenNext) next?.();
			});
			current = {
				stop() {
					handle.stop();
					stop();
				},
			};
		}

		btn.addEventListener('click', () => {
			if (btn.getAttribute('aria-pressed') === 'true') {
				current?.stop();
				current = null;
				return;
			}
			play(true);
		});

		render(0);
		return () => play(false);
	}

	const playReply = setupCard('response');
	setupCard('call', playReply);
</script>

<style>
	.thread-container {
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.audio-card {
		background: var(--ap-surface-card);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-lg);
		padding: var(--ap-space-5);
		box-shadow: var(--ap-shadow-md);
		position: relative;
		transition: all var(--ap-transition-fast);
	}

	.call-card {
		border-left: 4px solid var(--ap-call);
	}

	.response-card {
		border-left: 4px solid var(--ap-response);
		margin-inline-start: var(--ap-space-8);
	}

	.card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--ap-space-2);
		margin-bottom: var(--ap-space-3);
	}

	.actor-info {
		display: flex;
		align-items: center;
		gap: var(--ap-space-3);
		min-width: 0;
		flex: 1;
	}

	.actor-avatar {
		width: 36px;
		height: 36px;
		border-radius: var(--ap-radius-full);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: var(--ap-font-sm);
		flex-shrink: 0;
	}

	.call-avatar {
		background: var(--ap-call);
		color: var(--ap-text-inverse);
	}

	.response-avatar {
		background: var(--ap-response);
		color: var(--ap-neutral-900);
	}

	.actor-text {
		min-width: 0;
		overflow: hidden;
	}

	.actor-name {
		font-size: var(--ap-font-sm);
		font-weight: 600;
		color: var(--ap-text-primary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.actor-handle {
		font-weight: 400;
		color: var(--ap-text-muted);
		margin-inline-start: var(--ap-space-1);
	}

	.record-badge {
		font-family: var(--ap-font-mono);
		font-size: var(--ap-font-xs);
		color: var(--ap-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 16rem;
	}

	.type-pill {
		font-size: var(--ap-font-xs);
		font-weight: 600;
		padding: 2px var(--ap-space-2);
		border-radius: var(--ap-radius-sm);
		flex-shrink: 0;
	}

	.pill-call {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
	}

	.pill-response {
		background: var(--ap-response-subtle);
		color: var(--ap-response);
	}

	.card-prompt {
		font-size: var(--ap-font-base);
		color: var(--ap-text-primary);
		line-height: var(--ap-leading-snug);
		margin: 0 0 var(--ap-space-4);
	}

	.player-widget {
		display: flex;
		align-items: center;
		gap: var(--ap-space-3);
		background: var(--ap-surface-elevated);
		border: 1px solid var(--ap-border-subtle);
		border-radius: var(--ap-radius-md);
		padding: var(--ap-space-2) var(--ap-space-4);
		margin-bottom: var(--ap-space-3);
	}

	.play-btn {
		width: 36px;
		height: 36px;
		border-radius: var(--ap-radius-full);
		border: 1px solid transparent;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all var(--ap-transition-fast);
		flex-shrink: 0;
	}

	.play-call {
		background: var(--ap-call);
		color: var(--ap-text-inverse);
	}
	.play-call:hover {
		background: var(--ap-call-hover);
	}

	.play-response {
		background: var(--ap-response);
		color: var(--ap-neutral-900);
	}
	.play-response:hover {
		background: var(--ap-response-hover);
	}

	.waveform-container {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 38px;
		flex: 1;
		min-width: 0;
		padding-bottom: 2px;
	}

	.waveform-bar {
		flex: 1;
		min-width: 2px;
		border-radius: var(--ap-radius-sm);
		background: var(--ap-audio-waveform-unplayed);
		transition: background var(--ap-transition-fast);
	}

	.waveform-bar.played {
		background: var(--ap-call);
	}

	.bar-response.played {
		background: var(--ap-response);
	}

	.duration-display {
		font-family: var(--ap-font-mono);
		font-size: var(--ap-font-xs);
		color: var(--ap-text-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.transcript-preview {
		font-size: var(--ap-font-xs);
		color: var(--ap-text-secondary);
		background: var(--ap-surface-sunken);
		padding: var(--ap-space-2) var(--ap-space-3);
		border-radius: var(--ap-radius-sm);
		border-left: 2px solid var(--ap-border-default);
	}

	.transcript-label {
		font-weight: 600;
		color: var(--ap-text-muted);
		margin-inline-end: var(--ap-space-1);
	}

	.thread-connector {
		height: var(--ap-space-6);
		margin-inline-start: calc(var(--ap-space-8) + 18px);
		position: relative;
	}

	.connector-line {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--ap-border-default);
	}

	.connector-node {
		position: absolute;
		left: -3px;
		top: 50%;
		transform: translateY(-50%);
		width: 8px;
		height: 8px;
		border-radius: var(--ap-radius-full);
		background: var(--ap-response);
	}

	@media (max-width: 48rem) {
		.audio-card {
			padding: var(--ap-space-4);
		}

		.response-card {
			margin-inline-start: var(--ap-space-2);
		}

		.thread-connector {
			margin-inline-start: calc(var(--ap-space-2) + 18px);
		}

		.player-widget {
			padding: var(--ap-space-2) var(--ap-space-3);
			gap: var(--ap-space-2);
		}

		.record-badge {
			max-width: 10rem;
		}
	}
</style>
