---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;

const primaryNav = [
	{ label: 'Lexicons', href: '/lexicons/overview/', badge: 'Protocol' },
	{ label: 'Guides', href: '/self-hosting/quick-start/' },
	{ label: 'Capture Kit', href: '/build-your-own/capture-kit/' },
	{ label: 'Architecture', href: '/introduction/architecture/' },
	{ label: 'API Reference', href: '/api/overview/' },
];

function isActive(href: string): boolean {
	return currentPath.startsWith(href.replace(/\/$/, ''));
}
---

<div class="mobile-primary-section print:hidden">
	<div class="primary-section-title">Primary Navigation</div>
	<div class="primary-nav-list">
		{primaryNav.map((item) => (
			<a
				href={item.href}
				class:list={['primary-nav-item', { active: isActive(item.href) }]}
			>
				<span class="nav-label">{item.label}</span>
				{item.badge && <span class="nav-chip">{item.badge}</span>}
			</a>
		))}
	</div>
</div>

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.mobile-primary-section {
		display: block;
		padding-bottom: var(--ap-space-3);
		margin-bottom: var(--ap-space-3);
		border-bottom: 1px solid var(--ap-border-subtle);
	}

	@media (min-width: 64rem) {
		.mobile-primary-section {
			display: none;
		}
	}

	.primary-section-title {
		font-size: var(--ap-font-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ap-text-muted);
		margin-bottom: var(--ap-space-2);
		padding-inline: var(--ap-space-2);
	}

	.primary-nav-list {
		display: flex;
		flex-direction: column;
		gap: var(--ap-space-1);
	}

	.primary-nav-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--ap-space-2) var(--ap-space-3);
		border-radius: var(--ap-radius-md);
		font-size: var(--ap-font-sm);
		font-weight: 500;
		color: var(--ap-text-primary);
		text-decoration: none;
		transition: all var(--ap-transition-fast);
	}

	.primary-nav-item:hover {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
	}

	.primary-nav-item.active {
		background: var(--ap-call-subtle);
		color: var(--ap-call);
		font-weight: 600;
	}

	.nav-chip {
		font-size: var(--ap-font-xs);
		font-family: var(--ap-font-mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 1px var(--ap-space-2);
		border-radius: var(--ap-radius-full);
		background: var(--ap-response-subtle);
		color: var(--ap-response);
		border: 1px solid var(--ap-border-subtle);
	}
</style>
