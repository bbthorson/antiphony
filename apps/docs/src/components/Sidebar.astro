---
/**
 * The docs sidebar. Groups and links come from astro.config.mjs as usual;
 * under the current page it lists that page's H2s, so the questions a page
 * answers sit in the sidebar where Starlight's "On this page" used to be.
 */
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarGroup from './SidebarGroup.astro';
import { primaryNav, isActive } from '../lib/nav';

const { sidebar, headings } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
const questions = headings.filter((h) => h.depth === 2);
---

<div class="mobile-primary-section print:hidden">
	{primaryNav.map((item) => (
		<a href={item.href} class:list={['primary-nav-item', { active: isActive(item.href, currentPath) }]}>
			{item.label}
		</a>
	))}
</div>

<SidebarPersister>
	<SidebarGroup entries={sidebar} questions={questions} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.mobile-primary-section {
		display: flex;
		flex-direction: column;
		padding-bottom: 12px;
		margin-bottom: 20px;
		border-bottom: 1px solid var(--ap-border-subtle);
	}

	@media (min-width: 72rem) {
		.mobile-primary-section {
			display: none;
		}
	}

	.primary-nav-item {
		padding: 6px 12px;
		font-size: 14px;
		font-weight: 500;
		color: var(--ap-text-secondary);
		text-decoration: none;
		box-shadow: inset 2px 0 0 transparent;
	}

	.primary-nav-item.active {
		color: var(--ap-text-primary);
		font-weight: 600;
		box-shadow: inset 2px 0 0 var(--ap-call);
	}
</style>
