{
  "name": "@antiphony/docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Antiphony documentation site — Astro Starlight. Deploys to Cloudflare Workers (static assets) at docs.antiphony.dev.",
  "scripts": {
    "dev": "node scripts/copy-openapi.mjs && astro dev",
    "start": "node scripts/copy-openapi.mjs && astro dev",
    "build": "node scripts/copy-openapi.mjs --strict && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "astro preview",
    "astro": "^7.3.1"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "astro": "^7.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^7.0.2"
  }
}
