# Generated artifact — copied from ../core-api/openapi.json at build
# time by scripts/copy-openapi.mjs. Not committed: the source of truth
# is that file, which IS tracked here and regenerated by
# `npm run gen:openapi -w @antiphony/core-api`. Every build that serves
# this copy also produces it (`npm run build` passes --strict, so a
# missing source fails the build), Cloudflare's included — so there is
# no checkout in which it needs to already exist.
public/openapi.json

