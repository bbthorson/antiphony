{
  "name": "@antiphony/shared",
  "version": "0.7.0",
  "description": "Shared types, Zod schemas, and codecs for Antiphony — open audio call-and-response infrastructure and AT Protocol lexicons.",
  "license": "MIT",
  "homepage": "https://docs.antiphony.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbthorson/antiphony.git",
    "directory": "packages/shared"
  },
  "bugs": "https://github.com/bbthorson/antiphony/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./api-codecs": {
      "import": {
        "types": "./dist/esm/api-codecs.d.ts",
        "default": "./dist/esm/api-codecs.js"
      },
      "require": {
        "types": "./dist/cjs/api-codecs.d.cts",
        "default": "./dist/cjs/api-codecs.cjs"
      }
    },
    "./nsid": {
      "import": {
        "types": "./dist/esm/nsid.d.ts",
        "default": "./dist/esm/nsid.js"
      },
      "require": {
        "types": "./dist/cjs/nsid.d.cts",
        "default": "./dist/cjs/nsid.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/esm/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/cjs/errors/index.d.cts",
        "default": "./dist/cjs/errors/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils/index.d.ts",
        "default": "./dist/esm/utils/index.js"
      },
      "require": {
        "types": "./dist/cjs/utils/index.d.cts",
        "default": "./dist/cjs/utils/index.cjs"
      }
    },
    "./observability": {
      "import": {
        "types": "./dist/esm/observability/index.d.ts",
        "default": "./dist/esm/observability/index.js"
      },
      "require": {
        "types": "./dist/cjs/observability/index.d.cts",
        "default": "./dist/cjs/observability/index.cjs"
      }
    },
    "./observability/report-error": {
      "import": {
        "types": "./dist/esm/observability/report-error.d.ts",
        "default": "./dist/esm/observability/report-error.js"
      },
      "require": {
        "types": "./dist/cjs/observability/report-error.d.cts",
        "default": "./dist/cjs/observability/report-error.cjs"
      }
    },
    "./types/*": {
      "import": {
        "types": "./dist/esm/types/*.d.ts",
        "default": "./dist/esm/types/*.js"
      },
      "require": {
        "types": "./dist/cjs/types/*.d.cts",
        "default": "./dist/cjs/types/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "api-codecs": [
        "./dist/cjs/api-codecs.d.cts"
      ],
      "nsid": [
        "./dist/cjs/nsid.d.cts"
      ],
      "errors": [
        "./dist/cjs/errors/index.d.cts"
      ],
      "utils": [
        "./dist/cjs/utils/index.d.cts"
      ],
      "observability": [
        "./dist/cjs/observability/index.d.cts"
      ],
      "observability/report-error": [
        "./dist/cjs/observability/report-error.d.cts"
      ],
      "types/*": [
        "./dist/cjs/types/*.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs && tsup",
    "//prepare": "Every export in this package resolves into dist/, so a tree without it cannot be typechecked by the workspaces that consume it (apps/reference imports @antiphony/shared/* directly). npm runs prepare for workspace packages on install, which makes `git clone && npm ci && npm run typecheck` work on a cold checkout instead of only on a machine that happens to have built already.",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "//peerDependencies": "zod is a PEER, not a dependency, and the build has always assumed as much: tsup.config.ts marks it `external` so that there is ONE zod module instance shared with the consumer — the comment there spells out the consequence, that `@hono/zod-openapi`'s `.openapi()` extension never reaches schemas defined here if the instance is duplicated. Declaring it under `dependencies` said the opposite, that this package brings its own, and the contradiction was not theoretical: a consumer pinned to zod 3 against this package's range gets two instances. As a peer, npm resolves one instance and says so when it cannot. The range is `^4.0.0` following the Zod 4 migration.",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.70.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
